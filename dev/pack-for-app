#!/usr/bin/env bash
# Build, check and pack this fork for local installation into a consuming app.
#   dev/pack-for-app <dest-dir>   -> <dest-dir>/xmtp-react-native-sdk-mesh.tgz
# npm pack runs the package's `prepare` (expo-module prepare), which compiles src/ to build/.
set -euo pipefail
DEST="${1:?usage: dev/pack-for-app <dest-dir>}"
cd "$(dirname "$0")/.."
YARN=(node .yarn/releases/yarn-4.10.3.cjs)
"${YARN[@]}" install --immutable
npm run test:node
node_modules/.bin/tsc --noEmit -p tsconfig.json
mkdir -p "$DEST"
TGZ="$(CI=1 npm pack --pack-destination "$DEST" | tail -1)"
mv -f "$DEST/$TGZ" "$DEST/xmtp-react-native-sdk-mesh.tgz"
# Captured to a variable rather than piped straight into `grep -q`: under
# `pipefail`, `grep -q` closes its stdin on the first match, so `tar` gets
# SIGPIPE and the pipeline reports non-zero even when the file is present.
TARBALL_ENTRIES="$(tar -tzf "$DEST/xmtp-react-native-sdk-mesh.tgz")"
grep -q 'package/build/lib/meshSupport.js' <<<"$TARBALL_ENTRIES" \
  || { echo "pack-for-app: build/lib/meshSupport.js missing from the tarball" >&2; exit 1; }
echo "packed $DEST/xmtp-react-native-sdk-mesh.tgz"
